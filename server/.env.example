DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASS=
DB_DATABASE=game_wayfolk

# the port players connect to (the client's Constants.SERVER_PORT), and Stripe's webhook
PORT=5301

# 1 behind a reverse proxy that sets X-Forwarded-For (nginx and the like), so
# the sign-in limits go by each player's address and not the proxy's
TRUST_PROXY=0

# Premium (managers/billing): off until the key and webhook secret are set
PUBLIC_URL=http://localhost/idlerealm/client/dist/
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM=
# 1: Stripe Tax works out and adds sales tax / VAT at checkout (set it up in
# the Stripe Dashboard first: Tax, with your registrations)
STRIPE_AUTOMATIC_TAX=0

# Email (managers/auth/Mailer): password reset and confirm links, over SMTP.
# Until SMTP_HOST is set the emails are written to the server log instead.
# PUBLIC_URL above is where the links point.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Google sign-in (managers/auth/GoogleAccounts): the OAuth client id (type
# "Web application") from Google Cloud Console, with the site's address in its
# Authorized JavaScript origins. Empty: no Google button.
GOOGLE_CLIENT_ID=

# The map editor (admin menu, Map: shared/MapEdit.ts) paints the map into
# client/dist/assets/json/world.json and client/tools/world-paint.json. 0: off
# (the live box: a deploy pulls the repo over those files)
MAP_EDITING=1

# Logs (utils/Log): json writes one JSON object per line, for a log collector;
# anything else a readable line. LOG_LEVEL: debug, info, warn or error.
LOG_FORMAT=
LOG_LEVEL=info

# The Analytics on a phone (managers/analytics/StatsPage): <site>/stats/ asks
# for this key once. Make it long and random (openssl rand -hex 24). Empty: off.
STATS_KEY=

# Sentry (utils/Log): errors and crashes reported there. Empty: off.
# Use a different Sentry project from the client's (ErrorReporting.ts).
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
