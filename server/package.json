{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "app.js",
  "scripts": {
    "start:build": "tsc -w",
    "start:run": "nodemon build/server/src/app.js",
    "start": "concurrently npm:start:*",
    "schema": "node tools/dump-schema.js",
    "test": "tsc -p tsconfig.test.json && node --test \"build-test/**/*.test.js\"",
    "test:integration": "tsc -p . && tsc -p tsconfig.test.json && node --test --test-concurrency=1 \"build-test/server/test/integration/*.it.js\"",
    "test:load": "tsc -p . && tsc -p tsconfig.test.json && node build-test/server/test/integration/load.js"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@sentry/node": "^11.10.0",
    "bcrypt": "^6.0.0",
    "google-auth-library": "^10.9.1",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.3.1",
    "stripe": "^23.0.0",
    "ws": "^7.5.13"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/ws": "^7.4.0",
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.0",
    "typescript": "^5.9.3"
  }
}
